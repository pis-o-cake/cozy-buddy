# 맥 → 윈도우 dev 서버 접속 정보.
# `cp config.env.example config.env` 후 값을 채운다. config.env 는 gitignore.

WIN_HOST=192.168.0.10
WIN_USER=changeme
WIN_SSH_PORT=2222

# WARNING: `~` 금지 — source 시 맥 홈으로 확장된다. 원격 홈 기준 상대 경로로 쓸 것.
REMOTE_PATH=dev/cozy-buddy
LOCAL_PATH=$HOME/dev/private/cozy-buddy

SESSION_NAME=cozy-buddy-dev

# 윈도우 호스트에 publish 되는 nginx 포트 (server/docker-compose.yml 의 COZY_HTTP_PORT).
COZY_HTTP_PORT=8120

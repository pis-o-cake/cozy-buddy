# 복사해 .env 로 쓴다. 모든 값은 자리표시자다. 실제 값은 커밋하지 않는다.

# SQLite 파일 경로(비동기 드라이버). Docker 이미지는 /app/data/cozy.db 를 기본으로 쓴다.
COZY_DATABASE_URL=sqlite+aiosqlite:///data/cozy.db

# 정적 인증 토큰: kind:client_id:token 쉼표 목록. kind 는 hub 또는 mobile.
COZY_STATIC_TOKENS=hub:hub-1:change-me-hub-token,mobile:phone-1:change-me-mobile-token

# X-Real-IP/X-Forwarded-For 를 믿을 직접 연결 peer(IP/CIDR 쉼표 목록). 페어링 IP 제한에 쓰인다.
# 기본: 로컬 + docker bridge(172.16.0.0/12). compose 네트워크가 192.168.x 대역이면 추가한다.
# 프록시가 아닌 peer 가 보낸 헤더는 무시된다.
COZY_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ClientHello 대기 시간(초)
COZY_HELLO_TIMEOUT_SECONDS=10

COZY_LOG_LEVEL=INFO

# 사용자 응답 문구 언어팩(app/locales/<locale>.json)
COZY_LOCALE=ko

# Home Assistant 브리지. 둘 다 있어야 켜진다(없으면 빈 HomeSnapshot, 제어는 UPSTREAM_UNAVAILABLE).
# compose 에서는 http://homeassistant:8123 형태, host 네트워크면 http://host.docker.internal:8123 등.
COZY_HA_URL=http://homeassistant:8123
# HA 프로필 > 보안 > 장기 액세스 토큰
COZY_HA_TOKEN=change-me-ha-long-lived-token
# HA 요청 타임아웃(초)
COZY_HA_REQUEST_TIMEOUT_SECONDS=5

# 음성 파이프라인(OpenAI). OPENAI_API_KEY 가 있으면 켜지고, 그때는 아래 모델 이름이 모두 필수다.
# 키는 저장소 루트 .env 에만 둔다. 모델 이름에 코드 기본값은 없다(ADR 0004).
OPENAI_API_KEY=sk-change-me
# 권장 gpt-transcribe. gpt-4o-transcribe 는 2027-02-26 종료 예정이다(#55).
OPENAI_STT_MODEL=change-me-stt-model
OPENAI_LLM_MODEL=change-me-llm-model
OPENAI_TTS_MODEL=change-me-tts-model
OPENAI_TTS_VOICE=change-me-voice
# 추론 모델이 아니면 비워 둔다.
OPENAI_LLM_REASONING_EFFORT=none
# STT prompt 에 집의 방·기기 이름을 넣을지
COZY_STT_PROMPT_ENABLED=true
# LLM 조각 사이 대기 한도(초), 발화 최대 길이(초), 확인 질문 유지 시간(초), 시간대
COZY_LLM_TIMEOUT_SECONDS=10
COZY_MAX_UTTERANCE_SECONDS=15
COZY_CLARIFY_TTL_SECONDS=30
COZY_TIMEZONE=Asia/Seoul
# 턴 로그(발화별 경로·지연 기록) 보존 일수. 시작할 때와 하루마다 오래된 기록을 지운다.
COZY_TURN_LOG_DAYS=30

# 집 좌표. 둘 다 있어야 날씨(Open-Meteo, 키 불필요)가 켜진다. 비워 두면 날씨 기능은 꺼진다.
COZY_HOME_LATITUDE=
COZY_HOME_LONGITUDE=

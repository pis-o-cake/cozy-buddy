# 복사해 .env 로 쓴다. 모든 값은 자리표시자다. 실제 값은 커밋하지 않는다.

# SQLite 파일 경로(비동기 드라이버). Docker 이미지는 /app/data/cozy.db 를 기본으로 쓴다.
COZY_DATABASE_URL=sqlite+aiosqlite:///data/cozy.db

# 정적 인증 토큰: kind:client_id:token 쉼표 목록. kind 는 hub 또는 mobile.
COZY_STATIC_TOKENS=hub:hub-1:change-me-hub-token,mobile:phone-1:change-me-mobile-token

# ClientHello 대기 시간(초)
COZY_HELLO_TIMEOUT_SECONDS=10

COZY_LOG_LEVEL=INFO

# 사용자 응답 문구 언어팩(app/locales/<locale>.json)
COZY_LOCALE=ko

# Home Assistant 브리지. 둘 다 있어야 켜진다(없으면 빈 HomeSnapshot, 제어는 UPSTREAM_UNAVAILABLE).
# compose 에서는 http://homeassistant:8123 형태, host 네트워크면 http://host.docker.internal:8123 등.
COZY_HA_URL=http://homeassistant:8123
# HA 프로필 > 보안 > 장기 액세스 토큰
COZY_HA_TOKEN=change-me-ha-long-lived-token
# HA 요청 타임아웃(초)
COZY_HA_REQUEST_TIMEOUT_SECONDS=5
